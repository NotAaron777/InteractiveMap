<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MapaInteractivo.Maui.Views.RegionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MapaInteractivo.Maui.Models"
    Title="Región">

    <Grid RowDefinitions="Auto,*">

        <Border x:Name="encabezadoColor" Style="{StaticResource HeaderStyle}">
            <VerticalStackLayout Spacing="2" Padding="0,4">
                <Label x:Name="lblNombre" Style="{StaticResource TituloPaginaStyle}" />
                <Label x:Name="lblSubtitulo" Style="{StaticResource SubtituloPaginaStyle}" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,28" Spacing="12">

                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Secciones}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Seccion">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Titulo}" Style="{StaticResource TituloSeccionStyle}" />
                                    <Label Text="{Binding Texto}" Style="{StaticResource TextoSeccionStyle}" />
                                    <BoxView
                                        HeightRequest="1"
                                        Margin="0,4,0,0"
                                        Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label
                    x:Name="lblCaciquesTitulo"
                    Text="Caciques de esta zona"
                    FontFamily="OpenSansSemibold"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Primary}"
                    Margin="2,8,0,0"
                    IsVisible="False" />

                <VerticalStackLayout
                    x:Name="stCaciques"
                    Spacing="10"
                    BindableLayout.ItemsSource="{Binding Caciques}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Cacique">
                            <Border Style="{StaticResource CardStyle}" Padding="10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCaciqueTocado" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border
                                        WidthRequest="48" HeightRequest="48"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}"
                                        StrokeShape="RoundRectangle 24"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightCardGray}, Dark={StaticResource DarkCardGray}}">
                                        <Label
                                            Text="{Binding Iniciales}"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding Nombre}" FontFamily="OpenSansSemibold" FontSize="15" FontAttributes="Bold" />
                                        <Label Text="{Binding Pueblo}" FontSize="12" Style="{StaticResource TextoFuenteStyle}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="2"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Text="›"
                                        FontSize="22"
                                        TextColor="{StaticResource Primary}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>