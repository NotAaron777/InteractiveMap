<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MapaInteractivo.Maui.Views.CronologiaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MapaInteractivo.Maui.Models"
    Title="Cronología">

    <Grid RowDefinitions="Auto,*">

        <Border Style="{StaticResource HeaderStyle}">
            <VerticalStackLayout Spacing="2" Padding="0,2">
                <Label
                    Text="LÍNEA DE TIEMPO: DETALLE"
                    Style="{StaticResource TituloPaginaStyle}"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center" />
                <Label
                    Text="Hitos de los pueblos originarios"
                    Style="{StaticResource SubtituloPaginaStyle}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <Grid
            Grid.Row="1"
            x:Name="contenidoZoom"
            BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DarkBackground}}">
            <Grid.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnContenidoZoom" />
            </Grid.GestureRecognizers>

            <BoxView
                WidthRequest="3"
                HorizontalOptions="Center"
                Margin="0,10,0,10"
                Color="{StaticResource Purple}" />

            <CollectionView x:Name="listCronologia" Margin="0,10,0,24">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TimelineEvent">
                        <!-- Columna central Auto: se adapta al badge de año (p. ej. "Década de
                             1980") sin solapar las tarjetas, y crece con el ancho disponible. -->
                        <Grid ColumnDefinitions="*,Auto,*" Margin="0,4">

                            <!-- Tarjeta a la izquierda de la línea -->
                            <Border Grid.Column="0"
                                IsVisible="{Binding Izquierda}"
                                Style="{StaticResource EventCardStyle}"
                                Margin="8,0,12,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <!-- La imagen solo se muestra si el evento declara una;
                                         sin imagen, el texto aprovecha todo el ancho. -->
                                    <Border Grid.Column="0" WidthRequest="48" HeightRequest="48"
                                        StrokeShape="RoundRectangle 24" Padding="0"
                                        IsVisible="{Binding TieneImagen}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                                        <Image Source="{Binding Imagen}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding Titulo}" FontFamily="OpenSansSemibold" FontSize="14" FontAttributes="Bold"
                                            LineBreakMode="WordWrap"
                                            TextColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource DarkText}}" />
                                        <Label Text="{Binding Descripcion}"
                                            LineBreakMode="WordWrap"
                                            Style="{StaticResource TextoFuenteStyle}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Badge de año centrado sobre la línea morada -->
                            <Grid Grid.Column="1" MinimumWidthRequest="72">
                                <Border Style="{StaticResource BadgeAñoStyle}"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="{Binding Año}"
                                        TextColor="White"
                                        FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="10"
                                        LineBreakMode="NoWrap" HorizontalOptions="Center" />
                                </Border>
                            </Grid>

                            <!-- Tarjeta a la derecha de la línea -->
                            <Border Grid.Column="2"
                                IsVisible="{Binding NoIzquierda}"
                                Style="{StaticResource EventCardStyle}"
                                Margin="12,0,8,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding Titulo}" FontFamily="OpenSansSemibold" FontSize="14" FontAttributes="Bold"
                                            LineBreakMode="WordWrap"
                                            TextColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource DarkText}}" />
                                        <Label Text="{Binding Descripcion}"
                                            LineBreakMode="WordWrap"
                                            Style="{StaticResource TextoFuenteStyle}" />
                                    </VerticalStackLayout>
                                    <!-- La imagen solo se muestra si el evento declara una;
                                         sin imagen, el texto aprovecha todo el ancho. -->
                                    <Border Grid.Column="1" WidthRequest="48" HeightRequest="48"
                                        StrokeShape="RoundRectangle 24" Padding="0"
                                        IsVisible="{Binding TieneImagen}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                                        <Image Source="{Binding Imagen}" Aspect="AspectFill" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Button Grid.Row="1" x:Name="btnRestaurarZoom" Text="Restablecer zoom"
            Style="{StaticResource FabStyle}" FontSize="13" Padding="16,0"
            HorizontalOptions="End" VerticalOptions="End" Margin="0,0,14,14"
            IsVisible="False" Clicked="OnRestablecerZoom" />
    </Grid>
</ContentPage>
