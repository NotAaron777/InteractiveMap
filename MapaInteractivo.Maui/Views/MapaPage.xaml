<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MapaInteractivo.Maui.Views.MapaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MapaInteractivo.Maui.Controls"
    Title="Mapa">

    <Grid>

        <!-- Mapa interactivo a pantalla completa -->
        <controls:MapaInteractivoView x:Name="mapa" />

        <!-- Búsqueda flotante en cápsula + leyenda -->
        <VerticalStackLayout
            Margin="12,14,12,0"
            VerticalOptions="Start"
            Spacing="8">

            <Border
                Style="{StaticResource FloatingCardStyle}"
                StrokeShape="RoundRectangle 25"
                Padding="10,4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                    <SearchBar
                        x:Name="sbBuscar"
                        Placeholder="Buscar Cacique o Lugar..."
                        Style="{StaticResource SearchBarStyle}"
                        SearchButtonPressed="OnBuscar" />
                    <Button
                        Grid.Column="1"
                        Text="&#xE152;"
                        FontFamily="MaterialIcons" FontSize="22"
                        BackgroundColor="{StaticResource Navy}"
                        TextColor="White"
                        CornerRadius="16"
                        MinimumHeightRequest="44" MinimumWidthRequest="44"
                        Clicked="OnFiltro" />
                </Grid>
            </Border>

            <Border Style="{StaticResource FloatingCardStyle}" Padding="14,8" HorizontalOptions="Start">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="Toca un pin o una zona del mapa" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                    <Label Text="Pueblo y sus caciques" FontSize="11" Style="{StaticResource TextoFuenteStyle}" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Controles flotantes inferiores (esquina inferior izquierda) -->
        <VerticalStackLayout
            Margin="12,0,0,14"
            VerticalOptions="End"
            HorizontalOptions="Start"
            Spacing="10">

            <!-- Grupo de zoom vertical -->
            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Padding="0,4">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.12" Radius="8" Offset="0,3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Button
                        Text="+"
                        FontSize="22"
                        FontFamily="OpenSansSemibold"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkText}}"
                        MinimumHeightRequest="48" MinimumWidthRequest="48"
                        Clicked="OnAcercar" />
                    <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="12,0" />
                    <Button
                        Text="−"
                        FontSize="22"
                        FontFamily="OpenSansSemibold"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkText}}"
                        MinimumHeightRequest="48" MinimumWidthRequest="48"
                        Clicked="OnAlejar" />
                </VerticalStackLayout>
            </Border>

            <!-- Píldora Centrar -->
            <Border
                Style="{StaticResource FloatingCardStyle}"
                StrokeShape="RoundRectangle 22"
                Padding="16,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCentrar" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8">
                    <Label Text="&#xE8F4;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                    <Label Text="Centrar en mi ubicación" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

    </Grid>

</ContentPage>