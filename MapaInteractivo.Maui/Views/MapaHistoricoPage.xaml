<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MapaInteractivo.Maui.Views.MapaHistoricoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MapaInteractivo.Maui.Controls"
    xmlns:models="clr-namespace:MapaInteractivo.Maui.Models"
    Title="Mapa Histórico">

    <Grid>

        <!-- Mapa histórico a pantalla completa (independiente del mapa interactivo) -->
        <controls:MapaHistoricoView x:Name="mapa" />

        <!-- Guía superior -->
        <VerticalStackLayout
            Margin="12,14,12,0"
            VerticalOptions="Start"
            Spacing="8">

            <Border Style="{StaticResource FloatingCardStyle}" Padding="14,8" HorizontalOptions="Start">
                <HorizontalStackLayout Spacing="8">
                    <Label
                        Text="&#xE88B;"
                        FontFamily="MaterialIcons" FontSize="18"
                        TextColor="{StaticResource Navy}"
                        VerticalOptions="Center" />
                    <Label
                        Text="Pueblos originarios de Nicaragua"
                        FontSize="12" FontAttributes="Bold"
                        TextColor="{StaticResource Navy}"
                        VerticalOptions="Center" />
                    <Label
                        Text="Toca un territorio"
                        FontSize="11"
                        Style="{StaticResource TextoFuenteStyle}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Controles flotantes inferiores (esquina inferior izquierda) -->
        <VerticalStackLayout
            Margin="12,0,0,14"
            VerticalOptions="End"
            HorizontalOptions="Start"
            Spacing="10">

            <!-- Grupo de zoom vertical -->
            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Padding="0,4">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.12" Radius="8" Offset="0,3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Button
                        Text="+"
                        FontSize="22"
                        FontFamily="OpenSansSemibold"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkText}}"
                        MinimumHeightRequest="48" MinimumWidthRequest="48"
                        Clicked="OnAcercar" />
                    <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="12,0" />
                    <Button
                        Text="−"
                        FontSize="22"
                        FontFamily="OpenSansSemibold"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkText}}"
                        MinimumHeightRequest="48" MinimumWidthRequest="48"
                        Clicked="OnAlejar" />
                </VerticalStackLayout>
            </Border>

            <!-- Píldora Vista general -->
            <Border
                Style="{StaticResource FloatingCardStyle}"
                StrokeShape="RoundRectangle 22"
                Padding="16,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCentrar" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8">
                    <Label Text="&#xE5D0;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                    <Label Text="Vista general" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Panel de información del territorio seleccionado -->
        <Border
            x:Name="panelInfo"
            Style="{StaticResource CardStyle}"
            Margin="12,0,12,14"
            VerticalOptions="End"
            IsVisible="False">

            <Grid RowDefinitions="Auto,*" RowSpacing="10">

                <!-- Encabezado: color del territorio, nombre y cierre -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border
                        x:Name="dotTerritorio"
                        WidthRequest="18" HeightRequest="18"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 9"
                        BackgroundColor="#C9973B"
                        VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label x:Name="lblNombreTerritorio" FontFamily="DisplayFont" FontSize="18" TextColor="{StaticResource Navy}" />
                        <Label x:Name="lblSubtituloTerritorio" Style="{StaticResource TextoFuenteStyle}" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="2"
                        Text="&#xE5CD;"
                        FontFamily="MaterialIcons" FontSize="16"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Slate}"
                        CornerRadius="16"
                        MinimumHeightRequest="40" MinimumWidthRequest="40"
                        Clicked="OnCerrarPanel"
                        VerticalOptions="Center" />
                </Grid>

                <!-- Contenido desplazable -->
                <ScrollView Grid.Row="1" MaximumHeightRequest="280">
                    <VerticalStackLayout Spacing="10">

                        <!-- Modo territorio con un solo pueblo -->
                        <VerticalStackLayout x:Name="panelUnico" Spacing="10">
                            <Label x:Name="lblRegionDatos" FontSize="11" Style="{StaticResource TextoFuenteStyle}" />
                            <VerticalStackLayout Spacing="4" x:Name="panelPueblos">
                                <Label Text="Pueblos" Style="{StaticResource TituloSeccionStyle}" />
                                <Label x:Name="lblPueblos" Style="{StaticResource TextoSeccionStyle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" x:Name="panelHistoria">
                                <Label Text="Historia" Style="{StaticResource TituloSeccionStyle}" />
                                <Label x:Name="lblHistoria" Style="{StaticResource TextoSeccionStyle}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Modo macroterritorio con varios pueblos -->
                        <VerticalStackLayout x:Name="panelMultiple" Spacing="8" IsVisible="False">
                            <Label Text="Pueblos de este territorio" Style="{StaticResource TituloSeccionStyle}" />
                            <VerticalStackLayout x:Name="stPueblos" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Region">
                                        <Border Style="{StaticResource PillBorderStyle}" Padding="10,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnRegionTocada" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Nombre}" FontFamily="OpenSansSemibold" FontSize="14" FontAttributes="Bold" />
                                                    <Label Text="{Binding Subtitulo}" Style="{StaticResource TextoFuenteStyle}" />
                                                </VerticalStackLayout>
                                                <Label
                                                    Grid.Column="1"
                                                    Text="&#xE5CC;"
                                                    FontFamily="MaterialIcons" FontSize="16"
                                                    TextColor="{StaticResource Slate}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Button
                            x:Name="btnVerCompleta"
                            Text="Ver información completa"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Clicked="OnVerCompleta" />
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
