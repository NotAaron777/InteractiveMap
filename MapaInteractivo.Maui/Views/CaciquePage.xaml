<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MapaInteractivo.Maui.Views.CaciquePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MapaInteractivo.Maui.Models"
    Title="Cacique">

    <Grid RowDefinitions="Auto,*">

        <Border x:Name="encabezadoColor" Style="{StaticResource HeaderStyle}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border
                    WidthRequest="64" HeightRequest="64"
                    StrokeThickness="2" Stroke="{StaticResource Cyan}"
                    StrokeShape="RoundRectangle 32"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                    <!-- Avatar: imagen del cacique si existe; si no, iniciales (fallback) -->
                    <Grid>
                        <Label
                            x:Name="lblIniciales"
                            FontAttributes="Bold" FontSize="22"
                            TextColor="{StaticResource Primary}"
                            HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <Image
                            x:Name="imgCacique"
                            Aspect="AspectFill"
                            IsVisible="False"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
                    </Grid>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label x:Name="lblNombre" Style="{StaticResource TituloPaginaStyle}" />
                    <Label x:Name="lblPuebloPeriodo" Style="{StaticResource SubtituloPaginaStyle}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,28" Spacing="12">
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Secciones}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Seccion">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Titulo}" Style="{StaticResource TituloSeccionStyle}" />
                                    <Label Text="{Binding Texto}" Style="{StaticResource TextoSeccionStyle}" />
                                    <BoxView
                                        HeightRequest="1"
                                        Margin="0,4,0,0"
                                        Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>