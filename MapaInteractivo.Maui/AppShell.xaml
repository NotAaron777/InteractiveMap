<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MapaInteractivo.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MapaInteractivo.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
    Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource DarkText}}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource DarkText}}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Slate}, Dark={StaticResource DarkTextSecondary}}"
    Title="Caciques de Nicaragua">

    <TabBar>
        <ShellContent
            Title="Mapa"
            Route="mapa"
            Icon="{FontImageSource FontFamily=MaterialIcons, Glyph=&#xE55B;}"
            ContentTemplate="{DataTemplate views:MapaPage}" />
        <ShellContent
            Title="Cronología"
            Route="cronologia"
            Icon="{FontImageSource FontFamily=MaterialIcons, Glyph=&#xE8B5;}"
            ContentTemplate="{DataTemplate views:CronologiaPage}" />
        <ShellContent
            Title="Acerca"
            Route="acerca"
            Icon="{FontImageSource FontFamily=MaterialIcons, Glyph=&#xE7EF;}"
            ContentTemplate="{DataTemplate views:AcercaPage}" />
        <ShellContent
            Title="Config"
            Route="config"
            Icon="{FontImageSource FontFamily=MaterialIcons, Glyph=&#xE8B8;}"
            ContentTemplate="{DataTemplate views:ConfigPage}" />
    </TabBar>

</Shell>